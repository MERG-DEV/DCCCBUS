divert(-1)
changequote({,})

define(set_test_name, {define(test_name, patsubst(__file__, {.m4},))})

define(set_up_test_simulation,
Device PIC18F2480
Hwtool SIM
Program "../dist/default/production/dcccbus.production.cof"
Stim "./scl/test_name.scl"
Break *0 1)

define(run_test,
Run
Wait
Quit)

divert(0)dnl
